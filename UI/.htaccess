# Send plain-HTTP visitors to HTTPS (service workers and install need it).
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve the manifest with the proper type.
AddType application/manifest+json .webmanifest

# Browsers must check with the server before reusing the app's pages, code and styles (a
# quick "not modified" reply when nothing changed), so installed phones pick up an upload
# instead of a stored copy. The host's default lets browsers keep JS and CSS for a week
# without asking, which kept phones on old versions. This covers service-worker.js too, which must
# always be re-checked. The service worker keeps its own copy for offline use.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>
